[gd_resource type="Resource" script_class="MemeDesignRules" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/demo/resources/meme_design_rules.gd" id="1"]

[ext_resource type="Resource" path="res://content/demo/solutes.tres" id="solutes"]

[ext_resource type="Resource" path="res://content/demo/context_resources_v10.tres" id="contexts"]

[resource]
script = ExtResource("1")
solute_definitions = ExtResource("solutes")
definition_version = 5
module_slots = 5
bottle_slots = 3
starter_presets = PackedStringArray("case_s01", "case_r01", "case_p01")
modules = Array[Dictionary]([{
"id": "module_stance", "kernel_id": "stance", "title": "反问补丁", "description": "把平直陈述转成质疑，让读者注意情境与表态的落差。", "content":"这也能叫正常？", "draft_effects":[{"field":"recognizability","amount":0.08},{"field":"context_dependency","amount":0.05}],
"neuron_nodes": [{"id":"speaker","title":"发声者"},{"id":"visible_situation","title":"可见情境"},{"id":"claim","title":"表态"}],
"neuron_edges": [{"from":"speaker","to":"visible_situation"},{"from":"visible_situation","to":"claim"},{"from":"claim","to":"speaker"}]
}, {
"id": "module_relation", "kernel_id": "relation", "title": "对照补丁", "description": "并置双方承诺与实际所得，修正表达的比较方向而非更换核心关系。", "content":"把双方承诺与实际所得并置", "draft_effects":[{"field":"recognizability","amount":0.06}],
"neuron_nodes": [{"id":"role_a","title":"角色 A"},{"id":"role_b","title":"角色 B"},{"id":"relation","title":"关系"}],
"neuron_edges": [{"from":"role_a","to":"relation"},{"from":"relation","to":"role_b"},{"from":"role_b","to":"relation"}]
}, {
"id": "module_ritual", "kernel_id": "ritual", "title": "退出补丁", "description": "在接续表达中加入退出入口，让跟做不再成为唯一回应。", "content":"允许不跟做，也保留回应位置", "draft_effects":[{"field":"remix_cost","amount":-0.08}],
"neuron_nodes": [{"id":"trigger","title":"触发"},{"id":"action","title":"参与动作"},{"id":"response_and_exit","title":"回应与退出"}],
"neuron_edges": [{"from":"trigger","to":"action"},{"from":"action","to":"response_and_exit"},{"from":"response_and_exit","to":"trigger"}]
}, {
"id": "module_boundary", "kernel_id": "boundary", "title": "释义补丁", "description": "为圈外读者增加一句说明，降低携带语境的负担；不取消识别边界。", "content":"给圈外读者留下一句解释", "draft_effects":[{"field":"language_access","amount":0.08},{"field":"context_dependency","amount":-0.05}],
"neuron_nodes": [{"id":"invariant_trace","title":"不变痕迹"},{"id":"insider_context","title":"圈内语境"},{"id":"recognition_rule","title":"识别规则"}],
"neuron_edges": [{"from":"invariant_trace","to":"recognition_rule"},{"from":"insider_context","to":"recognition_rule"}]
}, {
"id": "module_shared_world", "kernel_id": "shared_world", "title": "续写补丁", "description": "留下可接续的表达缺口，不替后来者预设结论，也不恢复外部版本控制。", "content":"留下可接续但不替人定论的空白", "draft_effects":[{"field":"remix_cost","amount":-0.05}],
"neuron_nodes": [{"id":"premise","title":"世界前提"},{"id":"shared_rule","title":"共同规则"},{"id":"open_gap","title":"开放缺口"}],
"neuron_edges": [{"from":"premise","to":"shared_rule"},{"from":"shared_rule","to":"open_gap"},{"from":"open_gap","to":"premise"}]
}])
solvents = Array[Dictionary]([{"id":"language","title":"语言溶剂","boiling_order":1,"capacity":4,"saturation_units":1000,"initial_count":4},{"id":"group","title":"群体溶剂","boiling_order":2,"capacity":4,"saturation_units":1000,"initial_count":4},{"id":"topic","title":"主题溶剂","boiling_order":3,"capacity":4,"saturation_units":1000,"initial_count":2},{"id":"style","title":"风格试剂","boiling_order":4,"capacity":4,"saturation_units":1000,"initial_count":1}])
skills = Array[Dictionary]([{"id":"text","title":"文本","kind":"root","target_ids":["local_board"],"effect_text":"街区留言板渠道已解锁。","cost":0,"requires":[],"description":"把表达贴进街区留言板。"},{"id":"image","title":"图像媒介","kind":"medium","target_ids":["open_feed"],"effect_text":"公开推荐流渠道已解锁。","cost":8,"requires":["text"],"description":"让图像进入公开推荐流。"},{"id":"translation","title":"语言媒介","kind":"medium","target_ids":["open_feed"],"effect_text":"语言可达性 +0.1。","draft_effects":[{"field":"language_access","amount":0.1}],"cost":10,"requires":["text"],"description":"给不同语言的读者搭一座桥。"},{"id":"remix","title":"模板载体","kind":"carrier","target_ids":["remix_workshop"],"effect_text":"开放改写工坊渠道已解锁。","cost":12,"requires":["image"],"description":"把表达送进开放改写工坊。"},{"id":"network","title":"响应实例","kind":"instance","target_ids":["open_feed","remix_workshop"],"effect_text":"语境依赖 −0.1。","draft_effects":[{"field":"context_dependency","amount":-0.1}],"cost":14,"requires":["translation","remix"],"description":"让一句话在新的场合也能接上回应。"}])
initial_solute_count = 0
initial_solvent_count = 3
reward_solutes = {}

mass_units_per_solute = 1000
grinding_distance = 1.0
grinding_reversals = 3
grinding_stroke_limit = 0.35
solvent_dose = 1
solubility_caps = {
"language": {"observation":500,"response":250,"recontext":250,"authority":0,"deliberation":500,"translation":1000},
"group": {"observation":500,"response":1000,"recontext":250,"authority":750,"deliberation":1000,"translation":250},
"topic": {"observation":1000,"response":500,"recontext":1000,"authority":250,"deliberation":500,"translation":250},
"style": {"observation":250,"response":500,"recontext":750,"authority":1000,"deliberation":500,"translation":500}
}

liquid_units_per_quarter = 250
flask_liquid_capacity_units = 4000
neuron_base_volume_units = 1000
module_volume_units = 250

context_definitions = ExtResource("contexts")
axis_step = 0.1
context_depths = PackedFloat32Array(0.1, 0.3, 0.5, 0.7, 0.9)
