[gd_resource type="Resource" script_class="MemeDesignRules" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/demo/resources/meme_design_rules.gd" id="1"]

[ext_resource type="Resource" path="res://content/demo/solutes.tres" id="solutes"]

[resource]
script = ExtResource("1")
solute_definitions = ExtResource("solutes")
definition_version = 1
module_slots = 5
bottle_slots = 3
starter_presets = PackedStringArray("case_s01", "case_r01", "case_p01")
modules = Array[Dictionary]([{
"id": "module_stance", "kernel_id": "stance", "title": "立场基模", "description": "可见情境与表态形成判断落差。拓扑是游戏设计抽象。",
"neuron_nodes": [{"id":"speaker","title":"发声者"},{"id":"visible_situation","title":"可见情境"},{"id":"claim","title":"表态"}],
"neuron_edges": [{"from":"speaker","to":"visible_situation"},{"from":"visible_situation","to":"claim"},{"from":"claim","to":"speaker"}]
}, {
"id": "module_relation", "kernel_id": "relation", "title": "关系基模", "description": "关系节点连接双方，交换方向可改写。",
"neuron_nodes": [{"id":"role_a","title":"角色 A"},{"id":"role_b","title":"角色 B"},{"id":"relation","title":"关系"}],
"neuron_edges": [{"from":"role_a","to":"relation"},{"from":"relation","to":"role_b"},{"from":"role_b","to":"relation"}]
}, {
"id": "module_ritual", "kernel_id": "ritual", "title": "仪式基模", "description": "触发、参与和回应构成可退出的循环。",
"neuron_nodes": [{"id":"trigger","title":"触发"},{"id":"action","title":"参与动作"},{"id":"response_and_exit","title":"回应与退出"}],
"neuron_edges": [{"from":"trigger","to":"action"},{"from":"action","to":"response_and_exit"},{"from":"response_and_exit","to":"trigger"}]
}, {
"id": "module_boundary", "kernel_id": "boundary", "title": "边界基模", "description": "不变痕迹和圈内语境共同支撑识别。",
"neuron_nodes": [{"id":"invariant_trace","title":"不变痕迹"},{"id":"insider_context","title":"圈内语境"},{"id":"recognition_rule","title":"识别规则"}],
"neuron_edges": [{"from":"invariant_trace","to":"recognition_rule"},{"from":"insider_context","to":"recognition_rule"}]
}, {
"id": "module_shared_world", "kernel_id": "shared_world", "title": "共享世界基模", "description": "前提、共同规则与开放缺口相互支撑。",
"neuron_nodes": [{"id":"premise","title":"世界前提"},{"id":"shared_rule","title":"共同规则"},{"id":"open_gap","title":"开放缺口"}],
"neuron_edges": [{"from":"premise","to":"shared_rule"},{"from":"shared_rule","to":"open_gap"},{"from":"open_gap","to":"premise"}]
}])
solvents = Array[Dictionary]([{"id":"language","title":"语言溶剂","boiling_order":1,"capacity":4,"initial_count":4},{"id":"group","title":"群体溶剂","boiling_order":2,"capacity":4,"initial_count":4},{"id":"topic","title":"主题溶剂","boiling_order":3,"capacity":4,"initial_count":2},{"id":"style","title":"风格试剂","boiling_order":4,"capacity":4,"initial_count":1}])
skills = Array[Dictionary]([{"id":"text","title":"文本","kind":"root","target_ids":["local_board"],"effect_text":"支持街区留言板渠道。","cost":0,"requires":[],"description":"已解锁的根节点。"},{"id":"image","title":"图像媒介","kind":"medium","target_ids":["open_feed"],"effect_text":"解锁公开推荐流渠道支持，不增加总注意力。","cost":8,"requires":["text"],"description":"解锁传播研究的图像分支，不等同于购买模因商品。"},{"id":"translation","title":"语言媒介","kind":"medium","target_ids":["open_feed"],"effect_text":"可主动应用到自己的待发布草稿：语言可达性 +0.1；每草稿轮次一次（游戏启发式）。","draft_effects":[{"field":"language_access","amount":0.1}],"cost":10,"requires":["text"],"description":"解锁跨语言研究分支，不凭空增加注意力。"},{"id":"remix","title":"模板载体","kind":"carrier","target_ids":["remix_workshop"],"effect_text":"解锁开放改写工坊渠道支持，不改变再利用许可。","cost":12,"requires":["image"],"description":"解锁重混研究分支；不恢复外部版本的控制权。"},{"id":"network","title":"响应实例","kind":"instance","target_ids":["open_feed","remix_workshop"],"effect_text":"可主动应用到自己的待发布草稿：语境依赖 −0.1；每草稿轮次一次，不恢复外部控制（游戏启发式）。","draft_effects":[{"field":"context_dependency","amount":-0.1}],"cost":14,"requires":["translation","remix"],"description":"汇合两个分支，不替代现有群体相关性与传播模拟。"}])
initial_solute_count = 0
initial_solvent_count = 3
