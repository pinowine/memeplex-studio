[gd_resource type="Resource" script_class="MemeDemoEvent" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_event.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Condition_1"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"ge"
value = 12.0

[sub_resource type="Resource" id="Condition_2"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"le"
value = 18.0

[sub_resource type="Resource" id="Condition_3"]
script = ExtResource("2_condition")
field = &"exposed"
operator = &"ge"
value = 400.0

[sub_resource type="Resource" id="Condition_4"]
script = ExtResource("2_condition")
field = &"adopted"
operator = &"ge"
value = 25.0

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("3_effect")
effect_id = &"adoption"
amount = 0.06
duration_hours = 0.0
group_ids = PackedStringArray("students")

[resource]
script = ExtResource("1_event")
id = &"transmission_answer_chain"
title = "学生沿着原句开头接写回应"
narrative = "学生群沿着原句的同一开头接写各自的回应，并将前一位的短句留在下面。几名此前只围观的读者也开始使用这种说法，接句从转发变成了参与。"
mentor_comment = "接句总算给别人留了位置，独白少了一张继续扩建的许可证。"
origin = &"transmission"
topic_ids = PackedStringArray("language", "education", "community")
operation_ids = PackedStringArray("amplify")
conditions = Array[ExtResource("2_condition")]([SubResource("Condition_1"), SubResource("Condition_2"), SubResource("Condition_3"), SubResource("Condition_4")])
effects = Array[ExtResource("3_effect")]([SubResource("Effect_1")])
trigger_mode = &"random"
start_hour = 12.0
weight = 1.25
occurrence_chance = 0.04
cooldown_hours = 18.0
max_occurrences = 1
physical_duration_hours = 2.0
attention_duration_hours = 0.0
attention_decay = &"linear"
decay_parameter_hours = 0.0
discovery_ids = PackedStringArray("ritual")
evidence_status = &"design"
external_preset_id = &""
