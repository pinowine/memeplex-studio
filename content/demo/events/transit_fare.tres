[gd_resource type="Resource" script_class="MemeDemoEvent" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_event.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Condition_1"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"ge"
value = 4.0

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("3_effect")
effect_id = &"attention"
amount = 0.35
duration_hours = 12.0
group_ids = PackedStringArray("commuters")

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("3_effect")
effect_id = &"trust"
amount = -0.08
duration_hours = 0.0
group_ids = PackedStringArray("commuters")

[resource]
script = ExtResource("1_event")
id = &"transit_fare"
title = "纸灯港试行新的夜间票价"
narrative = "纸灯港交通局宣布试行新的夜间票价，夜班乘客的通勤账单随之调整。各站台公开新旧价目对照，乘客开始交换实际支出，并追问调价依据及账单来源。"
mentor_comment = "账单不会因为你的修辞少一行，先把多出来的那行找出来。"
origin = &"world"
topic_ids = PackedStringArray("policy", "cost_of_living", "work")
operation_ids = PackedStringArray("attention_shift")
conditions = Array[ExtResource("2_condition")]([SubResource("Condition_1")])
effects = Array[ExtResource("3_effect")]([SubResource("Effect_1"), SubResource("Effect_2")])
trigger_mode = &"scheduled"
start_hour = 4.0
weight = 1.0
occurrence_chance = 1.0
cooldown_hours = 0.0
max_occurrences = 1
physical_duration_hours = 12.0
attention_duration_hours = 18.0
attention_decay = &"linear"
decay_parameter_hours = 0.0
discovery_ids = PackedStringArray("relation")
evidence_status = &"design"
design_rewards = Array[Dictionary]([{"kind": "group", "id": "group_commuters", "count": 1}])
