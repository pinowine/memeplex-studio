[resource]
script = ExtResource("1_event")
id = &"transmission_workshop_demonstration"
title = "文化爱好者演示怎样重填原图"
narrative = "一名文化爱好者用自己的内容演示怎样重填原图，将空位和填写步骤逐一展示。几名此前只看过成品的读者开始照着使用，演示帖下面也出现了他们自己的例子。"
mentor_comment = "演示把空位亮了出来，比把作者履历填满整张图更方便别人动手。"
origin = &"transmission"
topic_ids = PackedStringArray("platform_tools", "community")
operation_ids = PackedStringArray("amplify")
conditions = Array[ExtResource("2_condition")]([SubResource("Condition_1"), SubResource("Condition_2"), SubResource("Condition_3"), SubResource("Condition_4")])
effects = Array[ExtResource("3_effect")]([SubResource("Effect_1")])
trigger_mode = &"random"
start_hour = 32.0
weight = 1.1
occurrence_chance = 0.035
cooldown_hours = 18.0
max_occurrences = 1
physical_duration_hours = 2.0
attention_duration_hours = 0.0
attention_decay = &"linear"
decay_parameter_hours = 0.0
discovery_ids = PackedStringArray("relation")
evidence_status = &"design"
external_preset_id = &""
design_rewards = Array[Dictionary]([{"kind": "pragmatic_token", "id": "ironic", "count": 1}])
