[gd_resource type="Resource" script_class="MemeDemoEvent" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_event.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Condition_1"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"ge"
value = 24.0

[sub_resource type="Resource" id="Condition_2"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"le"
value = 30.0

[sub_resource type="Resource" id="Condition_3"]
script = ExtResource("2_condition")
field = &"exposed"
operator = &"ge"
value = 850.0

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("3_effect")
effect_id = &"semantic_shift"
amount = 0.45
duration_hours = 0.0
group_ids = PackedStringArray()

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("3_effect")
effect_id = &"remix"
amount = 1.0
duration_hours = 0.0
group_ids = PackedStringArray("students")

[sub_resource type="Resource" id="Effect_3"]
script = ExtResource("3_effect")
effect_id = &"trust"
amount = -0.04
duration_hours = 0.0
group_ids = PackedStringArray("students")

[resource]
script = ExtResource("1_event")
id = &"transmission_context_removed"
title = "主句截图脱离说明段落流传"
narrative = "一张只剩主句的截图在学生群流传，原先的解释段落没有一同出现。几名读者将截图与原帖并排质疑，转发者随后提出无背景短版的改写方案。"
mentor_comment = "截图把解释段落留在门外，先把它领回来，别指望主句独自作证。"
origin = &"transmission"
topic_ids = PackedStringArray("language", "trust")
operation_ids = PackedStringArray("remix", "contest")
conditions = Array[ExtResource("2_condition")]([SubResource("Condition_1"), SubResource("Condition_2"), SubResource("Condition_3")])
effects = Array[ExtResource("3_effect")]([SubResource("Effect_1"), SubResource("Effect_2"), SubResource("Effect_3")])
trigger_mode = &"random"
start_hour = 24.0
weight = 1.2
occurrence_chance = 0.035
cooldown_hours = 18.0
max_occurrences = 1
physical_duration_hours = 2.0
attention_duration_hours = 0.0
attention_decay = &"linear"
decay_parameter_hours = 0.0
discovery_ids = PackedStringArray("boundary")
evidence_status = &"design"
external_preset_id = &""
