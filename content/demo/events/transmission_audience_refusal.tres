amount = -0.07
duration_hours = 0.0
group_ids = PackedStringArray("students")

[resource]
script = ExtResource("1_event")
id = &"transmission_audience_refusal"
title = "几名学生公开表示不愿跟用"
narrative = "几名学生在看到原帖后公开表示，这个说法不适合他们的经历。讨论没有因此结束，但他们对原帖的判断更警惕，也拒绝照着现有版本接写。"
mentor_comment = "受众没有跟用，招募表上至少保住了一个诚实的空格，先读他们的理由。"
origin = &"transmission"
topic_ids = PackedStringArray("identity", "education", "trust")
operation_ids = PackedStringArray("contest")
conditions = Array[ExtResource("2_condition")]([SubResource("Condition_1"), SubResource("Condition_2"), SubResource("Condition_3")])
effects = Array[ExtResource("3_effect")]([SubResource("Effect_1")])
trigger_mode = &"random"
start_hour = 29.0
weight = 1.35
occurrence_chance = 0.04
cooldown_hours = 18.0
max_occurrences = 1
physical_duration_hours = 2.0
attention_duration_hours = 0.0
attention_decay = &"linear"
decay_parameter_hours = 0.0
discovery_ids = PackedStringArray("boundary")
evidence_status = &"design"
external_preset_id = &""
