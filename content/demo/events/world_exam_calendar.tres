[gd_resource type="Resource" script_class="MemeDemoEvent" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_event.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Condition_1"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"ge"
value = 9.0

[sub_resource type="Resource" id="Condition_2"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"le"
value = 15.0

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("3_effect")
effect_id = &"attention"
amount = -0.2
duration_hours = 5.0
group_ids = PackedStringArray("students")

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("3_effect")
effect_id = &"fatigue"
amount = 0.08
duration_hours = 0.0
group_ids = PackedStringArray("students")

[resource]
script = ExtResource("1_event")
id = &"world_exam_calendar"
title = "学院将两场测验排在同一天"
narrative = "学院教务处调整测验日程，将两场测验安排在同一天。学生转而集中备考，群聊中的闲谈减少，留下的消息多为题目提示与临考求助。"
mentor_comment = "两场测验已经把一天排满，第三份长篇感想可以先不参加考试。"
origin = &"world"
topic_ids = PackedStringArray("education", "work")
operation_ids = PackedStringArray("fatigue", "attention_shift")
conditions = Array[ExtResource("2_condition")]([SubResource("Condition_1"), SubResource("Condition_2")])
effects = Array[ExtResource("3_effect")]([SubResource("Effect_1"), SubResource("Effect_2")])
trigger_mode = &"random"
start_hour = 9.0
weight = 1.3
occurrence_chance = 0.045
cooldown_hours = 18.0
max_occurrences = 1
physical_duration_hours = 6.0
attention_duration_hours = 5.0
attention_decay = &"linear"
decay_parameter_hours = 0.0
discovery_ids = PackedStringArray("boundary")
evidence_status = &"design"
external_preset_id = &""
