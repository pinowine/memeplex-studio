[gd_resource type="Resource" script_class="MemeDemoEvent" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_event.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Condition_1"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"ge"
value = 8.0

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("3_effect")
effect_id = &"semantic_shift"
amount = 0.2
duration_hours = 0.0
group_ids = PackedStringArray("culture_fans")

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("3_effect")
effect_id = &"remix"
amount = 1
duration_hours = 0.0
group_ids = PackedStringArray("culture_fans")

[resource]
script = ExtResource("1_event")
id = &"cross_language"
title = "文化工坊提交双语短句改写"
narrative = "文化工坊提交了一份双语短句方案，在图角保留原帖链接。新说法沿用原来的对照关系，工坊正在确认再利用条款，准备把它带进另一种语言的讨论。"
mentor_comment = "改写方案保留了出处，解释权可没附赠返程票。"
origin = &"transmission"
topic_ids = PackedStringArray("language", "community")
operation_ids = PackedStringArray("remix")
conditions = Array[ExtResource("2_condition")]([SubResource("Condition_1")])
effects = Array[ExtResource("3_effect")]([SubResource("Effect_1"), SubResource("Effect_2")])
trigger_mode = &"scheduled"
start_hour = 8.0
weight = 1.0
occurrence_chance = 1.0
cooldown_hours = 0.0
max_occurrences = 1
physical_duration_hours = 1.0
attention_duration_hours = 12.0
attention_decay = &"exponential"
decay_parameter_hours = 6.0
discovery_ids = PackedStringArray("boundary")
evidence_status = &"design"
design_rewards = Array[Dictionary]([{"kind": "language", "id": "language_en", "count": 1}])
