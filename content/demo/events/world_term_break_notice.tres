[gd_resource type="Resource" script_class="MemeDemoEvent" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_event.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Condition_1"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"ge"
value = 45.0

[sub_resource type="Resource" id="Condition_2"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"le"
value = 48.0

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("3_effect")
effect_id = &"fatigue"
amount = -0.06
duration_hours = 0.0
group_ids = PackedStringArray("students")

[resource]
script = ExtResource("1_event")
id = &"world_term_break_notice"
title = "学院发布短休整日通知"
narrative = "学院按原定安排发布短休整日通知，暂缓部分课程与例行活动。学生开始减少群聊提醒，把时间留给补眠和整理笔记，社群中的讨论也随之放缓。"
mentor_comment = "通知终于允许休息，别让你的下一条消息加班巡查。"
origin = &"world"
topic_ids = PackedStringArray("education", "community")
operation_ids = PackedStringArray("revive")
conditions = Array[ExtResource("2_condition")]([SubResource("Condition_1"), SubResource("Condition_2")])
effects = Array[ExtResource("3_effect")]([SubResource("Effect_1")])
trigger_mode = &"random"
start_hour = 45.0
weight = 0.95
occurrence_chance = 0.04
cooldown_hours = 18.0
max_occurrences = 1
physical_duration_hours = 6.0
attention_duration_hours = 0.0
attention_decay = &"linear"
decay_parameter_hours = 0.0
discovery_ids = PackedStringArray("ritual")
evidence_status = &"design"
external_preset_id = &""
