"title": "角色 B"
}, {
"id": "relation",
"title": "关系"
}],
"title": "对照补丁"
}, {
"content": "允许不跟做，也保留回应位置",
"description": "在接续表达中加入退出入口，让跟做不再成为唯一回应。",
"draft_effects": [{
"amount": -0.08,
"field": "remix_cost"
}],
