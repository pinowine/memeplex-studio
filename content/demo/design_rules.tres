"content": "这也能叫正常？",
"description": "把平直陈述转成质疑，让读者注意情境与表态的落差。",
"draft_effects": [{
"amount": 0.08,
"field": "recognizability"
}, {
"amount": 0.05,
"field": "context_dependency"
}],
"id": "module_stance",
