}, {
"id": "response_and_exit",
"title": "回应与退出"
}],
"title": "退出补丁"
}, {
"content": "给圈外读者留下一句解释",
"description": "为圈外读者增加一句说明，降低携带语境的负担；不取消识别边界。",
"draft_effects": [{
"amount": 0.08,
"field": "language_access"
}, {
"amount": -0.05,
"field": "context_dependency"
}],
"id": "module_boundary",
