id = &"case_w19"
kernel_id = &"shared_world"
title = "W19 · Tung Tung Tung Sahur"
required_slots = PackedStringArray("premise", "shared_rule", "open_gap")
slot_prompts = PackedStringArray("世界前提（可改写）", "共享规则（可改写）", "补写空缺（可改写）")
default_values = PackedStringArray("未回应 sahur 呼唤者会遇到持棍木人", "共享锚点：kentongan 木制外形、球棒、“tung”拟声；规则：斋月叫醒声被怪物化并参加角色战力赛", "它与其他 brainrot 角色的关系")
family_anchor = "共享锚点：kentongan 木制外形、球棒、“tung”拟声；识别与变异约束：替换场景和对手，保留三次敲击/呼名、木质人形与未回应即来访的规则。"
context_hint = "语义：传统清晨报时声被改造成带惩罚规则的 AI 都市传说角色。\n语用：用户复读名字、做战力对决和 3D 动画；许多海外用户只消费声音而不了解 sahur。\n跨语境：它常被误并入 Italian Brainrot，但宗教时间、印尼 kentongan 和本地语音是不可抹平的来源。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
