script = ExtResource("1_script")
id = &"case_s14"
kernel_id = &"stance"
title = "S14 · 说点大伙不知道的"
required_slots = PackedStringArray("speaker", "visible_situation", "claim")
slot_prompts = PackedStringArray("发声者（可改写）", "可见情境（可改写）", "表态框架（可改写）")
default_values = PackedStringArray("假装提供新知的评论者", "原帖说出常识或显然结论", "要求提供真正未知信息")
family_anchor = "识别与变异约束：替换“大伙/大家”，或接“不是哥们，真有不知道的”；核心是新知承诺与零增量落差。"
context_hint = "语义：以表面邀请补充知识的句式，反向标记内容过于浅显。\n语用：用于吐槽标题党、AI泛泛总结和解说废话；若原帖确实提供冷知识，又会被反转成真诚请求。\n跨语境：它与“谢谢你蒙鼓人”“老实人孤立你”同属元评论文化，评价的不是事件本身，而是信息增量。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
