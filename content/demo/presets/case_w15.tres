[resource]
script = ExtResource("1_script")
id = &"case_w15"
kernel_id = &"shared_world"
title = "W15 · 西方伪史论／万能《永乐大典》"
required_slots = PackedStringArray("premise", "shared_rule", "open_gap")
slot_prompts = PackedStringArray("世界前提（可改写）", "共享规则（可改写）", "补写空缺（可改写）")
default_values = PackedStringArray("西方古代史、科技史被系统伪造或抄自中国", "共享锚点：《永乐大典》、古希腊不存在、文物“一眼新”；规则：反证可被吸收为造假规模更大", "下一项发明/文明如何归源")
family_anchor = "共享锚点：《永乐大典》、古希腊不存在、文物“一眼新”；识别与变异约束：不断把蒸汽机、莎士比亚、希腊罗马等接到同一来源；“他们都在骗/都抄大典”是闭环规则。"
context_hint = "语义：用单一被盗/伪造框架解释庞杂历史，形成能持续吞并新材料的叙事世界。\n语用：既有真信传播，也有钓鱼、反讽与批判；仅凭夸张文本很难判断发帖者立场。\n跨语境：与普通玩梗不同，它包含可被相信的事实主张；语料必须标注证据状态，避免把虚假叙事当历史资料。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
