script = ExtResource("1_script")
id = &"case_w10"
kernel_id = &"shared_world"
title = "W10 · Main Character Energy"
required_slots = PackedStringArray("premise", "shared_rule", "open_gap")
slot_prompts = PackedStringArray("世界前提（可改写）", "共享规则（可改写）", "补写空缺（可改写）")
default_values = PackedStringArray("日常生活可按个人电影来体验", "共享锚点：main character、电影配乐、慢动作；规则：把普通行动构图为叙事中心", "下一幕/配角")
family_anchor = "共享锚点：main character、电影配乐、慢动作；识别与变异约束：替换场景、配乐、主配角；镜头语言而非固定台词维持前提。"
context_hint = "语义：将主体感与电影叙事词汇结合，为自我关注赋予积极或讽刺框架。\n语用：可鼓励主动生活，也可批评把他人降为背景；二者围绕同一世界模型争论。\n跨语境：疫情时期的孤立生活被重新拍成电影片段；平台同时产生反标签纠偏自我中心。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
