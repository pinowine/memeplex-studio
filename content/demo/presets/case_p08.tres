title = "P08 · Roman Empire Prompt"
required_slots = PackedStringArray("trigger", "action", "response_and_exit")
slot_prompts = PackedStringArray("触发时刻（可改写）", "参与动作（可改写）", "回应与退出（可改写）")
default_values = PackedStringArray("询问男性“你多久想一次罗马帝国”", "给出频率", "提问者惊讶/汇总；接续／退出：向更多人提问或转问个人执念")
family_anchor = "识别与变异约束：替换被问人或“Roman Empire”对象；意外高频回答与惊讶反应构成反馈。"
context_hint = "语义：看似随机的问题把隐性高频兴趣暴露为性别化共同模式。\n语用：既是伴侣测试也是群体统计游戏；后续“My Roman Empire”泛指反复想起的任何事。\n跨语境：历史知识被压成亲密关系中的发现仪式，并迅速脱离男性/古罗马限制。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
