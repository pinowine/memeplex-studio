[gd_resource type="Resource" script_class="MemeDemoKernel" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_kernel.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"boundary"
title = "边界信号"
description = "通过痕迹、圈内经验和识别门槛表现理解差异。并不将真实人口特征设置为理解能力加成，阈值属于设计。"
required_slots = PackedStringArray("invariant_trace", "insider_context", "recognition_rule")
slot_prompts = PackedStringArray("改写后仍保留什么痕迹？", "圈内人共享什么经验？", "谁凭什么认得出来？")
default_values = PackedStringArray("被擦掉一角的圆形站牌", "长期在纸灯港夜班换乘", "认出缺角指向最后一班车，圈外只能看到不完整图形")
family_anchor = "站牌缺角与最后一班车的共同记忆构成圈内识别线索"
split_threshold = 0.6
evidence_status = &"design"
