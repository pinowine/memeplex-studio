[gd_resource type="Resource" script_class="MemeDemoKernel" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_kernel.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"stance"
title = "立场反差"
description = "三个槽位只实现反差立场原型，并非全部立场理论或完整节点拓扑。默认案例为虚构表达，分家阈值0.6是设计参数。"
required_slots = PackedStringArray("speaker", "visible_situation", "claim")
slot_prompts = PackedStringArray("谁在解释眼前的事实？", "现场有什么可见证据？", "他说的话与现场形成什么落差？")
default_values = PackedStringArray("夜班通勤者", "站台时钟停在昨天，列车仍在等待", "一切都按计划运行")
family_anchor = "发声者的平静主张与可见混乱之间存在可识别的反差"
split_threshold = 0.6
evidence_status = &"design"
