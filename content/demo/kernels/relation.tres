[gd_resource type="Resource" script_class="MemeDemoKernel" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/demo/resources/meme_demo_kernel.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"relation"
title = "关系模板"
description = "以两个可替换位置及关系构成可复用表达。三个槽位是本Demo的语义简化，不声称复现全部节点端口。"
required_slots = PackedStringArray("role_a", "role_b", "relation")
slot_prompts = PackedStringArray("第一个可替换位置是谁？", "第二个可替换位置是什么？", "二者的关系方向是什么？")
default_values = PackedStringArray("我的月薪", "通勤票价", "前者追着后者跑，却总差一步")
family_anchor = "两个可替换角色保持明确的追赶关系"
split_threshold = 0.6
evidence_status = &"design"
