title = "S16 · Why Is This So Peak?／Peak Fiction"
required_slots = PackedStringArray("speaker", "visible_situation", "claim")
slot_prompts = PackedStringArray("发声者（可改写）", "可见情境（可改写）", "表态框架（可改写）")
default_values = PackedStringArray("被作品击中的观众", "质量出乎意料的正片或荒诞二创", "它达到“peak”")
family_anchor = "识别与变异约束：可写 this is peak、peak fiction、beyond peak；高强度褒义与低预期画面是常见落差。"
context_hint = "语义：把“高峰”从相对比较改成绝对质量标签，越低成本的素材被叫 peak，反差越强。\n语用：可真诚赞美剧情，也可后讽刺地把粗糙 shitpost 加冕为巅峰艺术。\n跨语境：评价词脱离具体作品标准，成为粉丝同步兴奋的口令；局外人难判断认真或反讽。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
