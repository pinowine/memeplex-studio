title = "W05 · Barbenheimer"
required_slots = PackedStringArray("premise", "shared_rule", "open_gap")
slot_prompts = PackedStringArray("世界前提（可改写）", "共享规则（可改写）", "补写空缺（可改写）")
default_values = PackedStringArray("《Barbie》与《Oppenheimer》是同一天的互补双片", "共享锚点：粉红芭比/黑白爆炸视觉；规则：把相反情绪并置", "观影顺序、混搭角色和海报")
family_anchor = "共享锚点：粉红芭比/黑白爆炸视觉；识别与变异约束：替换海报人物、观影顺序和色彩比例；二元视觉冲突是世界入口。"
context_hint = "语义：混成词把商业竞争重写为可共同消费的文化事件。\n语用：用户规划双片连看、晒混搭服装并制作交叉海报；电影公司也借势但并非完全控制。\n跨语境：它表明对立品牌可因观众的组合行动获得附加叙事，也带有核历史被娱乐化的张力。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
