default_values = PackedStringArray("马桶头与监控人阵营冲突", "共享锚点：“skibidi”音轨、马桶头、摄像机头；规则：升级式战斗与身体变形", "阵营历史和下一次升级")
family_anchor = "共享锚点：“skibidi”音轨、马桶头、摄像机头；识别与变异约束：新增 Titan、阵营、能力与同人支线；头部器物和音轨是跨版本锚点。"
context_hint = "语义：单集弱语言、强视觉的荒诞冲突累积成可追更的战争神话。\n语用：儿童与青少年通过角色等级、剧情解释和复刻进入共同世界；“看不懂”也成为代际边界。\n跨语境：短时长算法内容并未排斥长线 lore，反而通过高频升级和评论考据维持世界。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
