script = ExtResource("1_script")
id = &"case_p01"
kernel_id = &"ritual"
title = "P01 · 秋天的第一杯奶茶"
required_slots = PackedStringArray("trigger", "action", "response_and_exit")
slot_prompts = PackedStringArray("触发时刻（可改写）", "参与动作（可改写）", "回应与退出（可改写）")
default_values = PackedStringArray("入秋/天气转凉", "赠送奶茶或发 52.0 元红包并晒图", "感谢、回赠或跟帖；接续／退出：每年立秋复现或拒绝消费仪式")
family_anchor = "识别与变异约束：替换季节、商品、金额或关系对象；稳定循环是节点提醒—赠予—展示—模仿。"
context_hint = "语义：奶茶从饮品变为“被惦记”的可视化证明，金额和时间承担关系指示。\n语用：参与者借跟做确认亲密关系；反参与者用“第一杯水/西北风”等改写消费压力。\n跨语境：小额消费、季节节点和公开展示结合，使私人关怀平台化；商家随后接管话题。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
