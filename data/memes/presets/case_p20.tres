script = ExtResource("1_script")
id = &"case_p20"
kernel_id = &"ritual"
title = "P20 · 猫 Meme／Happy Happy Happy Cat"
required_slots = PackedStringArray("trigger", "action", "response_and_exit")
slot_prompts = PackedStringArray("触发时刻（可改写）", "参与动作（可改写）", "回应与退出（可改写）")
default_values = PackedStringArray("日常故事需要一个情绪回合", "选择 Happy、香蕉哭猫、Huh Cat 等素材配音", "观众凭角色认出情绪；接续／退出：换猫进入下一情节或故事结束")
family_anchor = "识别与变异约束：可新增猫角色和本地音乐；素材—情绪映射必须足够稳定，才能像表意文字一样组合。"
context_hint = "语义：每只猫成为预先约定的情绪动词，多个片段可拼成无真人出镜的第一人称故事。\n语用：参与者不是单纯转发，而是从共享素材库选角、剪辑和本地化字幕。\n跨语境：同一猫素材在日语、中文、韩语叙事间迁移；重复使用建立角色共识，也产生原动物来源被遮蔽的问题。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
