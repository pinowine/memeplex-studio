script = ExtResource("1_script")
id = &"case_w16"
kernel_id = &"shared_world"
title = "W16 · 地平说／Flat Earth 迷因生态"
required_slots = PackedStringArray("premise", "shared_rule", "open_gap")
slot_prompts = PackedStringArray("世界前提（可改写）", "共享规则（可改写）", "补写空缺（可改写）")
default_values = PackedStringArray("地球为平面且真相被机构隐藏", "共享锚点：南极冰墙、穹顶、NASA 造假；规则：官方证据被解释为共谋", "墙外世界和遮蔽动机")
family_anchor = "共享锚点：南极冰墙、穹顶、NASA 造假；识别与变异约束：新增飞行路线、日月模型和冰墙地图；“所有机构共同遮蔽”保证世界不会被单一反证关闭。"
context_hint = "语义：它不是单一笑话，而是能自我保护的另类世界模型；同一图像也可被反方用来嘲讽。\n语用：用户通过“自己研究”建立圈内权威，反讽者则用“members all around the globe”等矛盾句拆解。\n跨语境：研究应区分信念、娱乐、算法测试与辟谣；转发辟谣仍可能增强锚点曝光。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
