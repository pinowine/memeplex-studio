title = "S15 · Breaking News: Water Found in Sea／Ocean"
required_slots = PackedStringArray("speaker", "visible_situation", "claim")
slot_prompts = PackedStringArray("发声者（可改写）", "可见情境（可改写）", "表态框架（可改写）")
default_values = PackedStringArray("假装播报突发新闻的人", "某人把显然事实当洞见", "“海里发现水”")
family_anchor = "识别与变异约束：替换物质与地点，保持“Breaking News: X found in X 的自然容器”同义结构。"
context_hint = "语义：用不可能更显然的标题，量化一条观点的低信息量。\n语用：常回帖讽刺“众所周知的理论发现”，也能引出 fork found in kitchen、air found in atmosphere 等接龙。\n跨语境：新闻台视觉借来权威感，内容却完全空洞；与中文“说点大伙不知道的”形成跨语种同功能对照。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
