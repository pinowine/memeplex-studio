slot_prompts = PackedStringArray("世界前提（可改写）", "共享规则（可改写）", "补写空缺（可改写）")
default_values = PackedStringArray("动物与物件混合体组成荒诞宇宙", "共享锚点：Tralalero Tralala、Bombardiro Crocodilo 等押韵名；规则：AI拟真混种+夸张旁白", "新角色关系和战力")
family_anchor = "共享锚点：Tralalero Tralala、Bombardiro Crocodilo 等押韵名；识别与变异约束：角色=动物A+物件B+押韵名+能力；开放槽位几乎无限，视觉质感和命名节奏维持一致。"
context_hint = "语义：语义依赖声音、形态错配与不断增殖的伪百科，而非连贯故事。\n语用：参与者通过命名新生物、排名和做家谱证明熟悉度；冒犯性原音频常在跨语传播中被忽略。\n跨语境：这是生成式 AI 低成本供给、儿童文化和无意义音韵结合的代表，也提醒研究记录原音频含义。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
