script = ExtResource("1_script")
id = &"case_w14"
kernel_id = &"shared_world"
title = "W14 · 酸黄瓜和通哥／酸黄瓜跳舞"
required_slots = PackedStringArray("premise", "shared_rule", "open_gap")
slot_prompts = PackedStringArray("世界前提（可改写）", "共享规则（可改写）", "补写空缺（可改写）")
default_values = PackedStringArray("会跳舞的酸黄瓜与“通哥/通通哥”等角色持续生活、造房", "共享锚点：细长绿色身体、魔性舞步、固定账号名；规则：低解释的角色行为不断续集化", "下一次建造/冲突")
family_anchor = "共享锚点：细长绿色身体、魔性舞步、固定账号名；识别与变异约束：可替换舞曲、角色比例和任务；酸黄瓜轮廓、通哥配对及连续日更承诺构成世界锚。"
context_hint = "语义：视觉先于叙事：观众从反复共现中把怪形象识别为角色，并自行补足关系。\n语用：用于制造猎奇笑点、记忆污染和“还是没躲开”的被动观看感，评论又给角色追加设定。\n跨语境：它代表中文 2026 AI/低成本 3D 抽象角色链，也与更早木棍人、Italian Brainrot 的形态谱系互文。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
