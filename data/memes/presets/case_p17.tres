[resource]
script = ExtResource("1_script")
id = &"case_p17"
kernel_id = &"ritual"
title = "P17 · Pikki Pikki Dance（삐끼삐끼）"
required_slots = PackedStringArray("trigger", "action", "response_and_exit")
slot_prompts = PackedStringArray("触发时刻（可改写）", "参与动作（可改写）", "回应与退出（可改写）")
default_values = PackedStringArray("投手三振对手/节拍响起", "啦啦队员做拇指与髋部小幅舞步", "球迷和创作者复刻；接续／退出：每次三振重演或音乐结束")
family_anchor = "识别与变异约束：动作、服装、地点可换；手部节拍和短循环音轨是识别核心。"
context_hint = "语义：极简动作把赛场结果转成可循环、可近距离观看的胜利信号。\n语用：用户模仿动作或聚焦啦啦队员反应；观看重心也会从比赛转向人物颜值与劳动。\n跨语境：韩国职业棒球的本土应援制度被国际受众以舞蹈挑战重新理解，原触发条件常在传播中丢失。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
