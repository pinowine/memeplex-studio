title = "W17 · Lobotomy Kaisen"
required_slots = PackedStringArray("premise", "shared_rule", "open_gap")
slot_prompts = PackedStringArray("世界前提（可改写）", "共享规则（可改写）", "补写空缺（可改写）")
default_values = PackedStringArray("《咒术回战》休刊期间粉丝集体“失智”", "共享锚点：Nah I’d Win、Domain Expansion、Are You X Because Y；规则：越重复、错译和低理性越合格", "下一话/下一种台词污染")
family_anchor = "共享锚点：Nah I’d Win、Domain Expansion、Are You X Because Y；识别与变异约束：新角色可获得领域展开和固定问句；作品角色、字幕字体和跨梗密度保持家族相似。"
context_hint = "语义：休刊造成的内容真空被共享语法填满，零散模因因此组成自指世界。\n语用：参与者以能同时调用多条台词证明深度入圈；“lobotomy”既自嘲也为低质创作预先免责。\n跨语境：它显示粉丝文化会在官方停更时自行生产准正典语言，随后外溢到完全无关角色。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
