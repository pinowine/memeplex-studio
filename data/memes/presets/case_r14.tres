script = ExtResource("1_script")
id = &"case_r14"
kernel_id = &"relation"
title = "R14 · Looksmaxxing／Mogging／Mewing"
required_slots = PackedStringArray("role_a", "role_b", "relation")
slot_prompts = PackedStringArray("角色 A（可改写）", "角色 B（可改写）", "关系方向（可改写）")
default_values = PackedStringArray("被评价的脸/身体", "更符合审美等级的 mogger 或想象标准", "比较、改造、压倒")
family_anchor = "识别与变异约束：派生 X-maxxing、mogged、bye-bye mewing；必须保留可比较的高低位置。"
context_hint = "语义：把外貌拆成可优化参数，并把同框吸引力差解释为一方“mog”另一方。\n语用：可作为健身/造型自助，也常以滤镜自恋作反讽；极端实践会把伪科学和身体焦虑游戏化。\n跨语境：边缘男性等级词被去来源化为校园手势和玩笑，但仍携带性别、种族与测量化审美偏见。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
