title = "S10 · Chill Guy"
required_slots = PackedStringArray("speaker", "visible_situation", "claim")
slot_prompts = PackedStringArray("发声者（可改写）", "可见情境（可改写）", "表态框架（可改写）")
default_values = PackedStringArray("棕色拟人犬角色", "压力或冲突", "“just a chill guy”")
family_anchor = "识别与变异约束：换背景、换服装、添加“when…”处境；角色站姿和微笑是视觉不变量。"
context_hint = "语义：以极低反应强度对照高压背景，编码一种不费力的冷静人设。\n语用：常作自我投射，也可讽刺逃避责任；广告和加密代币挪用又改变其所有权语境。\n跨语境：“chill”是一种男性气质和情绪管理表演；作者身份与无许可商业化成为模因伦理案例。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
