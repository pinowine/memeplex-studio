title = "B12 · bro／bruh 与“Bro thinks he’s…”"
required_slots = PackedStringArray("invariant_trace", "insider_context", "recognition_rule")
slot_prompts = PackedStringArray("稳定痕迹（可改写）", "圈内语境（可改写）", "识别门槛（可改写）")
default_values = PackedStringArray("brother 的同伴称呼/惊讶反应", "游戏、短视频和评论文化用户；失真路径：bro 截短、bruh 元音变化，再进入“Bro thinks…”模板", "懂得 bro 可指非真实兄弟乃至物件；圈外读法：只按男性亲属读")
family_anchor = "识别与变异约束：替换 thinks/visited 后的谓语与主体，甚至称动物和物件为 bro；句首定位是稳定迹线。"
context_hint = "语义：bro 从称呼语变成可匿名评论任何主体的句法前缀，bruh 则压缩无语反应。\n语用：“Bro thinks he’s him”否定某人的自我想象；“bro visited his friend”则以过度平淡描述荒诞画面。\n跨语境：源自非裔口语传统并被全球青年语吸收；去来源化和泛性别化同时发生。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
