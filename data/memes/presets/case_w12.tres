title = "W12 · The Backrooms／Kane Pixels revival"
required_slots = PackedStringArray("premise", "shared_rule", "open_gap")
slot_prompts = PackedStringArray("世界前提（可改写）", "共享规则（可改写）", "补写空缺（可改写）")
default_values = PackedStringArray("从现实 noclip 会坠入无限黄墙空间", "共享锚点：潮湿地毯、黄墙、荧光灯嗡鸣；规则：层级/实体/机构痕迹可扩写", "出口和世界真相")
family_anchor = "共享锚点：潮湿地毯、黄墙、荧光灯嗡鸣；识别与变异约束：可新增房间、层级与机构，但日常空间的错误空无和荧光声保持。"
context_hint = "语义：熟悉办公空间的空无感被建模为可无限延伸的恐怖世界。\n语用：参与者通过层级档案、实体设计、游戏和 found-footage 补写；多个正典并存。\n跨语境：它连接 liminal space 审美、协作恐怖写作与个人作者影像，展示共享世界的分叉治理。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
