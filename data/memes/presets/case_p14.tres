[resource]
script = ExtResource("1_script")
id = &"case_p14"
kernel_id = &"ritual"
title = "P14 · 会员制餐厅"
required_slots = PackedStringArray("trigger", "action", "response_and_exit")
slot_prompts = PackedStringArray("触发时刻（可改写）", "参与动作（可改写）", "回应与退出（可改写）")
default_values = PackedStringArray("说出“本餐厅是会员制”或展示特殊料理", "服务者按身份上菜", "客人勉强评价/拒绝；接续／退出：继续上菜与惩罚脚本或切出")
family_anchor = "识别与变异约束：替换服务员、客人和菜品；“会员制宣告—定制料理—难以下咽—惩罚”是仪式顺序。"
context_hint = "语义：普通高端餐饮词被圈内语重写为对猎奇“料理”和强制用餐流程的暗号。\n语用：用于把游戏、动漫角色配进固定餐厅流程，也会作为隐晦链接诱导；不了解来源者只看到普通餐饮词。\n跨语境：这是强门槛亚文化：原素材含成人与恶心内容，研究时应区分纯句式二创、来源知情程度与平台规避写法。\n这是分类文档的结构抽象，不是截图逐字转录、实证数值、事实认可或版权许可；政治、语用坐标与六维仍由玩家设置。"
