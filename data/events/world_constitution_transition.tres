response_profile = {"attention": 0.7, "spread": 0.25, "production": 0.6, "sentiment": 0.25, "authority_affinity": -0.55, "freedom_affinity": 0.65, "equality_affinity": 0.35, "hierarchy_affinity": -0.3, "controversy": 0.9, "positive_frames": ["LOC_EVENT_WORLD_CONSTITUTION_TRANSITION_POSITIVE"], "negative_frames": ["LOC_EVENT_WORLD_CONSTITUTION_TRANSITION_NEGATIVE"], "group_reactions": {}}
external_preset_id = &""
mutation_kind = &""
mutation_topic_ids = PackedStringArray()
mutation_stance_delta = Vector2(0.0, 0.0)
mutation_pragmatic_delta = Vector2(0.0, 0.0)
operation_ids = PackedStringArray("attention_shift")
trigger_mode = &"random"
start_hour = 0.0
weight = 1.2
occurrence_chance = 1.0
cooldown_hours = 24.0
max_occurrences = 1
physical_duration_hours = 18.0
attention_duration_hours = 24.0
attention_decay = &"linear"
discovery_ids = PackedStringArray()
evidence_status = &"design"
design_rewards = Array[Dictionary]([{"kind":"topic", "id":"topic_policy", "count":1}])
