[gd_resource type="Resource" script_class="MemeDemoEvent" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_event.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
id = &"world_constitution_transition"
category = &"political"
origin = &"world"
title = "LOC_EVENT_WORLD_CONSTITUTION_TRANSITION_TITLE"
narrative = "LOC_EVENT_WORLD_CONSTITUTION_TRANSITION_NARRATIVE"
mentor_comment = "LOC_EVENT_WORLD_CONSTITUTION_TRANSITION_COMMENT"
