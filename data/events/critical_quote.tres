[gd_resource type="Resource" script_class="MemeDemoEvent" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_event.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Condition_1"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"ge"
value = 30.0

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("3_effect")
effect_id = &"trust"
amount = -0.12
duration_hours = 0.0
group_ids = PackedStringArray()

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("3_effect")
effect_id = &"semantic_shift"
amount = 0.35
duration_hours = 0.0
group_ids = PackedStringArray()

[sub_resource type="Resource" id="Effect_3"]
script = ExtResource("3_effect")
effect_id = &"remix"
amount = 1
duration_hours = 0.0
group_ids = PackedStringArray()

[resource]
script = ExtResource("1_event")
id = &"critical_quote"
title = "文化评论者引用原帖，质疑其结论"
narrative = "一位文化评论者把原帖放进批评文章，指出其中的公平说法忽略了被排除的人。读者沿着引用链接展开争论，原句开始以反讽的语气出现在转发中。"
mentor_comment = "转发量里也住着反对票，先把那段批评读完再庆祝。"
origin = &"transmission"
topic_ids = PackedStringArray("trust", "identity", "language")
operation_ids = PackedStringArray("contest", "remix")
conditions = Array[ExtResource("2_condition")]([SubResource("Condition_1")])
effects = Array[ExtResource("3_effect")]([SubResource("Effect_1"), SubResource("Effect_2"), SubResource("Effect_3")])
trigger_mode = &"scheduled"
start_hour = 30.0
weight = 1.0
occurrence_chance = 1.0
cooldown_hours = 0.0
max_occurrences = 1
physical_duration_hours = 2.0
attention_duration_hours = 10.0
attention_decay = &"exponential"
decay_parameter_hours = 5.0
discovery_ids = PackedStringArray("stance")
evidence_status = &"design"
