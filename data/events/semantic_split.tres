[gd_resource type="Resource" script_class="MemeDemoEvent" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_event.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Condition_1"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"ge"
value = 20.0

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("3_effect")
effect_id = &"semantic_shift"
amount = 0.75
duration_hours = 0.0
group_ids = PackedStringArray()

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("3_effect")
effect_id = &"remix"
amount = 1
duration_hours = 0.0
group_ids = PackedStringArray()

[resource]
script = ExtResource("1_event")
id = &"semantic_split"
title = "外部工坊提出相反规则的改写"
narrative = "外部工坊提出了一份沿用原图轮廓的改写方案，把核心关系改成相反的规则。提案附上原帖链接，并明确表示新结论由工坊负责；发布前的再利用确认仍在进行。"
mentor_comment = "他们保留原链接，像退货时保留小票，不代表还打算照原说明使用。"
origin = &"environment_meme"
topic_ids = PackedStringArray("identity", "language")
operation_ids = PackedStringArray("split", "remix")
conditions = Array[ExtResource("2_condition")]([SubResource("Condition_1")])
effects = Array[ExtResource("3_effect")]([SubResource("Effect_1"), SubResource("Effect_2")])
trigger_mode = &"scheduled"
start_hour = 20.0
weight = 1.0
occurrence_chance = 1.0
cooldown_hours = 0.0
max_occurrences = 1
physical_duration_hours = 1.0
attention_duration_hours = 16.0
attention_decay = &"linear"
decay_parameter_hours = 0.0
discovery_ids = PackedStringArray("boundary")
evidence_status = &"design"
