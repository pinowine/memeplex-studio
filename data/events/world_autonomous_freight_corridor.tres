mentor_comment = "LOC_EVENT_WORLD_AUTONOMOUS_FREIGHT_CORRIDOR_COMMENT"
topic_ids = PackedStringArray("transport", "work", "public_safety")
response_profile = {"attention": 0.62, "spread": 0.24, "production": 0.6, "sentiment": -0.15, "authority_affinity": 0.25, "freedom_affinity": 0.1, "equality_affinity": -0.4, "hierarchy_affinity": 0.45, "controversy": 0.85, "positive_frames": ["LOC_EVENT_WORLD_AUTONOMOUS_FREIGHT_CORRIDOR_POSITIVE"], "negative_frames": ["LOC_EVENT_WORLD_AUTONOMOUS_FREIGHT_CORRIDOR_NEGATIVE"], "group_reactions": {"industrial_workers": -0.4, "tech_workers": 0.35, "small_business": 0.15, "commuters": -0.15}}
external_preset_id = &""
conditions = Array[ExtResource("2_cond")]([SubResource("Cond_0"), SubResource("Cond_1")])
mutation_kind = &""
mutation_topic_ids = PackedStringArray()
mutation_stance_delta = Vector2(0.0, 0.0)
mutation_pragmatic_delta = Vector2(0.0, 0.0)
operation_ids = PackedStringArray("attention_shift", "platform_change")
trigger_mode = &"threshold"
start_hour = 10.0
weight = 1.05
occurrence_chance = 1.0
cooldown_hours = 24.0
max_occurrences = 1
physical_duration_hours = 14.0
attention_duration_hours = 20.0
attention_decay = &"linear"
discovery_ids = PackedStringArray()
evidence_status = &"design"
