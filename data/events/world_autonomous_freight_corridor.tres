[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_condition.gd" id="2_cond"]

[sub_resource type="Resource" id="Cond_0"]
script = ExtResource("2_cond")
field = &"hour"
operator = &"ge"
value = 10.0

[sub_resource type="Resource" id="Cond_1"]
script = ExtResource("2_cond")
field = &"exposed"
operator = &"ge"
value = 120.0

[resource]
script = ExtResource("1_event")
id = &"world_autonomous_freight_corridor"
category = &"technology"
origin = &"world"
