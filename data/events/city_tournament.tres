response_profile = {"attention": 0.6, "spread": 0.24, "production": 0.55, "sentiment": 0.55, "authority_affinity": 0.0, "freedom_affinity": 0.15, "equality_affinity": 0.35, "hierarchy_affinity": -0.2, "controversy": 0.2, "positive_frames": ["LOC_EVENT_CITY_TOURNAMENT_POSITIVE"], "negative_frames": ["LOC_EVENT_CITY_TOURNAMENT_NEGATIVE"], "group_reactions": {"commuters": 0.2, "students": 0.1}}
external_preset_id = &""
mutation_kind = &""
mutation_topic_ids = PackedStringArray()
mutation_stance_delta = Vector2(0.0, 0.0)
mutation_pragmatic_delta = Vector2(0.0, 0.0)
operation_ids = PackedStringArray("attention_shift")
trigger_mode = &"random"
start_hour = 0.0
weight = 1.2
occurrence_chance = 1.0
cooldown_hours = 24.0
max_occurrences = 1
physical_duration_hours = 18.0
attention_duration_hours = 24.0
attention_decay = &"linear"
discovery_ids = PackedStringArray()
evidence_status = &"design"
