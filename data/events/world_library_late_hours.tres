[gd_resource type="Resource" script_class="MemeDemoEvent" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_event.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Condition_1"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"ge"
value = 7.0

[sub_resource type="Resource" id="Condition_2"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"le"
value = 13.0

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("3_effect")
effect_id = &"channel_reach"
amount = 0.18
duration_hours = 6.0
group_ids = PackedStringArray("students")

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("3_effect")
effect_id = &"fatigue"
amount = -0.03
duration_hours = 0.0
group_ids = PackedStringArray("students")

[resource]
script = ExtResource("1_event")
id = &"world_library_late_hours"
title = "海堤图书馆延长晚间开放"
narrative = "海堤图书馆试行延长晚间开放，留出晚课后的学习座位。学生不必在闭馆后匆忙寻找去处，馆内的笔记交换区也为后来者提供了接续讨论的地方。"
mentor_comment = "图书馆只是晚点关门，长篇废话还没有拿到延期许可。"
origin = &"world"
topic_ids = PackedStringArray("education", "community")
operation_ids = PackedStringArray("attention_shift", "revive")
conditions = Array[ExtResource("2_condition")]([SubResource("Condition_1"), SubResource("Condition_2")])
effects = Array[ExtResource("3_effect")]([SubResource("Effect_1"), SubResource("Effect_2")])
trigger_mode = &"random"
start_hour = 7.0
weight = 0.9
occurrence_chance = 0.03
cooldown_hours = 18.0
max_occurrences = 1
physical_duration_hours = 10.0
attention_duration_hours = 6.0
attention_decay = &"linear"
decay_parameter_hours = 0.0
discovery_ids = PackedStringArray("shared_world")
evidence_status = &"design"
external_preset_id = &""
