[gd_resource type="Resource" script_class="MemeDemoEvent" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_event.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Condition_1"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"ge"
value = 32.0

[sub_resource type="Resource" id="Condition_2"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"le"
value = 38.0

[sub_resource type="Resource" id="Condition_3"]
script = ExtResource("2_condition")
field = &"exposed"
operator = &"ge"
value = 950.0

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("3_effect")
effect_id = &"semantic_shift"
amount = 0.82
duration_hours = 0.0
group_ids = PackedStringArray()

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("3_effect")
effect_id = &"remix"
amount = 1.0
duration_hours = 0.0
group_ids = PackedStringArray("commuters")

[resource]
script = ExtResource("1_event")
id = &"environment_relation_flip"
title = "职员群提议翻转原帖的对照结论"
narrative = "一个职员群公布了改写方案，把原帖的对照关系翻转成相反结论。方案仍附原链接，但署名者表示这次推论与原作者不同，正在核对可再利用的部分。"
mentor_comment = "对照表翻过来还是对照表，结论却换了户主，先把搬走的那一步标出来。"
origin = &"environment_meme"
topic_ids = PackedStringArray("work", "cost_of_living", "identity")
operation_ids = PackedStringArray("split", "remix")
conditions = Array[ExtResource("2_condition")]([SubResource("Condition_1"), SubResource("Condition_2"), SubResource("Condition_3")])
effects = Array[ExtResource("3_effect")]([SubResource("Effect_1"), SubResource("Effect_2")])
trigger_mode = &"random"
start_hour = 32.0
weight = 1.25
occurrence_chance = 0.03
cooldown_hours = 18.0
max_occurrences = 1
physical_duration_hours = 2.0
attention_duration_hours = 0.0
attention_decay = &"linear"
decay_parameter_hours = 0.0
discovery_ids = PackedStringArray("relation")
evidence_status = &"design"
external_preset_id = &""
