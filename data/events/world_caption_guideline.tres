[gd_resource type="Resource" script_class="MemeDemoEvent" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_event.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Condition_1"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"ge"
value = 17.0

[sub_resource type="Resource" id="Condition_2"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"le"
value = 23.0

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("3_effect")
effect_id = &"channel_reach"
amount = 0.2
duration_hours = 7.0
group_ids = PackedStringArray("culture_fans")

[resource]
script = ExtResource("1_event")
id = &"world_caption_guideline"
title = "公共频道发布新版字幕指引"
narrative = "公共频道发布新版字幕制作指引，示例同时展示清晰字号与双语注释。创作者开始按指引补全字幕，原本难以辨读的配文获得了更清楚的展示。"
mentor_comment = "字幕能救回看不清的字，救不了一句绕到下班的解释。"
origin = &"world"
topic_ids = PackedStringArray("platform_tools", "language")
operation_ids = PackedStringArray("platform_change")
conditions = Array[ExtResource("2_condition")]([SubResource("Condition_1"), SubResource("Condition_2")])
effects = Array[ExtResource("3_effect")]([SubResource("Effect_1")])
trigger_mode = &"random"
start_hour = 17.0
weight = 0.8
occurrence_chance = 0.03
cooldown_hours = 18.0
max_occurrences = 1
physical_duration_hours = 16.0
attention_duration_hours = 7.0
attention_decay = &"exponential"
decay_parameter_hours = 4.0
discovery_ids = PackedStringArray("relation")
evidence_status = &"design"
external_preset_id = &""
