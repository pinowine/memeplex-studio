[gd_resource type="Resource" script_class="MemeDemoEvent" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_event.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/resources/events/meme_demo_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Condition_1"]
script = ExtResource("2_condition")
field = &"hour"
operator = &"ge"
value = 16.0

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("3_effect")
effect_id = &"attention"
amount = -0.2
duration_hours = 12.0
group_ids = PackedStringArray()

[resource]
script = ExtResource("1_event")
id = &"competitor_birth"
title = "“漏掉一分钟”短图在街角流传"
narrative = "纸灯港街角出现了一组名为“漏掉一分钟”的短图，发布者邀请路人补写各自错过的小事。几家本地群聊开始转发这些续篇，原先讨论其他表达的人也加入了接写。"
mentor_comment = "别人漏掉一分钟就留出了接写的位置，你的长文先别把最后一个空位占满。"
origin = &"environment_meme"
topic_ids = PackedStringArray("community", "archive")
operation_ids = PackedStringArray("emerge", "attention_shift")
conditions = Array[ExtResource("2_condition")]([SubResource("Condition_1")])
effects = Array[ExtResource("3_effect")]([SubResource("Effect_1")])
trigger_mode = &"scheduled"
start_hour = 16.0
weight = 1.0
occurrence_chance = 1.0
cooldown_hours = 0.0
max_occurrences = 1
physical_duration_hours = 6.0
attention_duration_hours = 12.0
attention_decay = &"exponential"
decay_parameter_hours = 6.0
discovery_ids = PackedStringArray("shared_world")
evidence_status = &"design"
