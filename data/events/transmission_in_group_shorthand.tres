group_ids = PackedStringArray("culture_fans")

[resource]
script = ExtResource("1_event")
id = &"transmission_in_group_shorthand"
title = "熟人群把原句缩成一个暗号"
narrative = "文化爱好者在熟人群里把原句缩成一个暗号，发出时不再附上完整解释。看过早先讨论的成员开始跟用，外来读者则仍在询问它指的是哪件事。"
mentor_comment = "暗号省下了熟人的解释，也替陌生人加了一道安检，别把两边算成同一种顺畅。"
origin = &"transmission"
topic_ids = PackedStringArray("identity", "community")
operation_ids = PackedStringArray("amplify")
conditions = Array[ExtResource("2_condition")]([SubResource("Condition_1"), SubResource("Condition_2"), SubResource("Condition_3"), SubResource("Condition_4")])
effects = Array[ExtResource("3_effect")]([SubResource("Effect_1")])
trigger_mode = &"random"
start_hour = 17.0
weight = 1.0
occurrence_chance = 0.035
cooldown_hours = 18.0
max_occurrences = 1
physical_duration_hours = 2.0
attention_duration_hours = 0.0
attention_decay = &"linear"
decay_parameter_hours = 0.0
discovery_ids = PackedStringArray("boundary")
evidence_status = &"design"
external_preset_id = &""
